{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "jsxImportSource": "preact",
    "strict": true, "noImplicitAny": false, "skipLibCheck": true, "allowJs": true, "checkJs": false,
    "noEmit": true, "lib": ["ES2022", "DOM"]
  },
  "include": ["src"]
}
