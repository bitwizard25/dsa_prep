{
  "name": "dsa-practice",
  "version": "2.3.0",
  "description": "Personal LeetCode practice app: company-based plans, focus timer, streaks, all saved locally",
  "main": "src/main/index.js",
  "scripts": {
    "test": "node --test tests/*.test.*",
    "check": "npm test && npm --prefix hub-src run check",
    "smoke": "electron tools/smoke-electron.cjs",
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:linux": "electron-builder --linux AppImage",
    "build:hub": "cd hub-src && npm run build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "local.dsapractice",
    "productName": "DSA Practice",
    "files": [
      "src/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build-assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DSA Practice",
      "installerIcon": "build-assets/icon.ico",
      "uninstallerIcon": "build-assets/icon.ico",
      "installerHeaderIcon": "build-assets/icon.ico",
      "installerHeader": "build-assets/installerHeader.bmp",
      "installerSidebar": "build-assets/installerSidebar.bmp",
      "uninstallerSidebar": "build-assets/installerSidebar.bmp",
      "artifactName": "dsa_prep_setup_${version}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "category": "Education"
    },
    "directories": {
      "buildResources": "build-assets",
      "output": "dist"
    },
    "executableName": "dsa_prep"
  }
}
